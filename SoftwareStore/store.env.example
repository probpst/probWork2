# Software Store 설정 파일 예시.
# 이 파일을 "store.env" 로 복사한 뒤 메모장으로 값을 바꾸세요. (store.env 는 git 에 올라가지 않습니다)
# run_store.bat 을 처음 실행하면 자동으로 store.env 가 만들어집니다.

# 결제 방식: mock (테스트, 실제 결제 없음) 또는 toss (토스페이먼츠)
PAYMENT_PROVIDER=mock

# 토스페이먼츠 결제위젯 키 (PAYMENT_PROVIDER=toss 일 때 필요)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 관리자 페이지(/admin) 비밀번호. 비워 두면 관리자 페이지가 꺼집니다.
ADMIN_PASSWORD=

# 사이트 이름
STORE_NAME=Software Store

# 접속 주소. 이 PC 에서만: 127.0.0.1 / 다른 PC·인터넷에서도 접속: 0.0.0.0
HOST=127.0.0.1
PORT=5000

# 서버 시작 시 브라우저 자동 열기 (1=예, 0=아니오)
OPEN_BROWSER=1
